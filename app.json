{
  "expo": {
    "name": "LingoToday",
    "slug": "lingotoday-mobile",
    "version": "1.0.0",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#6366f1"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lingotoday.mobile",
      "infoPlist": {
        "UIBackgroundModes": [
          "fetch",
          "remote-notification"
        ],
        "NSUserTrackingUsageDescription": "We use your data to provide a better experience and to improve our services.",
        "NSLocationWhenInUseUsageDescription": "We use your location to provide a better experience and to improve our services.",
        "NSCameraUsageDescription": "We use your camera to take photos of your progress."
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#6366f1"
      },
      "package": "com.lingotoday.mobile",
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.SCHEDULE_EXACT_ALARM",
        "android.permission.POST_NOTIFICATIONS",
        "com.android.vending.BILLING"
      ],
      "useNextNotificationsApi": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      "expo-notifications"
    ],
    "scheme": "lingotoday",
    "sdkVersion": "54.0.0",
    "extra": {
      "apiBaseUrl": "https://www.lingotoday.co",
      "eas": {
        "projectId": "b5c4ecbe-0f0f-4f0f-8f8e-b155460d2f03"
      }
    },
    "owner": "lingotoday"
  }
}
