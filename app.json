{
  "expo": {
    "name": "LingoToday",
    "slug": "lingotoday-mobile",
    "version": "1.0.1",
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#6366f1"
    },
    "assetBundlePatterns": [
      "**/*"
    ],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lingotoday.mobile",
      "infoPlist": {
        "NSUserNotificationUsageDescription": "LingoToday sends you reminders to help you stay consistent with your language learning practice.",
        "NSLocationWhenInUseUsageDescription": "We use your location to provide a better experience and to improve our services.",
        "NSCameraUsageDescription": "We use your camera to take photos of your progress."
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#6366f1"
      },
      "package": "com.lingotoday.mobile",
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "com.android.vending.BILLING",
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "com.android.vending.BILLING"
      ],
      "useNextNotificationsApi": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#6366f1",
          "enableBackgroundRemoteNotifications": true
        }
      ]
    ],
    "scheme": "lingotoday",
    "sdkVersion": "54.0.0",
    "extra": {
      "apiBaseUrl": "https://lingotoday.replit.app",
      "eas": {
        "projectId": "b5c4ecbe-0f0f-4f0f-8f8e-b155460d2f03"
      }
    },
    "owner": "lingotoday",
    "runtimeVersion": {
      "policy": "appVersion"
    },
    "updates": {
      "url": "https://u.expo.dev/b5c4ecbe-0f0f-4f0f-8f8e-b155460d2f03"
    }
  }
}
