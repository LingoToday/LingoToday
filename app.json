{
  "expo": {
    "name": "LingoToday",
    "slug": "lingotoday-mobile",
    "version": "1.0.10",
    "newArchEnabled": false,
    "orientation": "portrait",
    "icon": "./assets/icon.png",
    "userInterfaceStyle": "light",
    "splash": {
      "image": "./assets/splash-icon.png",
      "resizeMode": "contain",
      "backgroundColor": "#0a1628"
    },
    "assetBundlePatterns": ["**/*"],
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.lingotoday.mobile",
      "buildNumber": "13",
      "bitcode": false,
      "infoPlist": {
        "NSUserNotificationUsageDescription": "LingoToday sends you reminders to help you stay consistent with your language learning practice.",
        "NSLocationWhenInUseUsageDescription": "We use your location to provide a better experience and to improve our services.",
        "NSCameraUsageDescription": "We use your camera to take photos of your progress.",
        "NSMicrophoneUsageDescription": "LingoToday uses your microphone to practice conversations with the AI avatar."
      },
      "config": {
        "usesNonExemptEncryption": false
      }
    },
    "android": {
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#6366f1"
      },
      "package": "com.lingotoday.mobile",
      "versionCode": 48,
      "permissions": [
        "android.permission.RECEIVE_BOOT_COMPLETED",
        "android.permission.POST_NOTIFICATIONS",
        "android.permission.VIBRATE",
        "com.android.vending.BILLING",
        "android.permission.RECORD_AUDIO",
        "android.permission.CAMERA"
      ],
      "useNextNotificationsApi": true
    },
    "web": {
      "favicon": "./assets/favicon.png"
    },
    "plugins": [
      [
        "expo-notifications",
        {
          "color": "#6366f1",
          "enableBackgroundRemoteNotifications": true
        }
      ],
      "@livekit/react-native-expo-plugin",
      "@config-plugins/react-native-webrtc",
      [
        "expo-build-properties",
        {
          "ios": {
            "buildReactNativeFromSource": true
          }
        }
      ]
    ],
    "scheme": "lingotoday",
    "sdkVersion": "54.0.0",
    "extra": {
      "apiBaseUrl": "https://lingotoday.replit.app",
      "eas": {
        "projectId": "b5c4ecbe-0f0f-4f0f-8f8e-b155460d2f03"
      }
    },
    "owner": "lingotoday"
  }
}
